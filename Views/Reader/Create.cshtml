@model CNPM_DeMo.Models.ReaderCard

@{
    ViewData["Title"] = "Lập Thẻ Độc Giả";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h4 class="fw-bold text-primary mb-1"><i class="bi bi-person-plus"></i> Lập Thẻ Độc Giả</h4>
        <a asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div class="row g-5">
                <div class="col-md-7 border-end">
                    <h6 class="fw-bold text-muted mb-3">Thông tin cá nhân</h6>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label fw-bold">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="HoTen" class="form-control" placeholder="Nhập họ và tên..." required />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NgaySinh" class="form-label fw-bold">Ngày sinh <span class="text-danger">*</span></label>
                        <input asp-for="NgaySinh" type="text" class="form-control datepicker bg-white" placeholder="dd/mm/yyyy" required />
                        <span asp-validation-for="NgaySinh" class="text-danger small fw-bold mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoDienThoai" class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                        <input asp-for="SoDienThoai" class="form-control" required />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DiaChi" class="form-label fw-bold">Địa chỉ <span class="text-danger">*</span></label>
                        <input asp-for="DiaChi" class="form-control" required />
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-5 bg-light p-4 rounded-3">
                    <h6 class="fw-bold text-primary mb-3">Thông tin thẻ (Hệ thống cấp)</h6>

                    <input type="hidden" asp-for="NgayCap" />

                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted">Mã thẻ mới</label>
                        <input asp-for="MaThe" class="form-control bg-white fw-bold text-primary" readonly />
                        <small class="text-muted mt-1 d-block">Mã tự sinh hệ thống</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted">Ngày hết hạn (Dự kiến)</label>
                        <input value="@Model.NgayHetHan.ToString("dd/MM/yyyy")" class="form-control bg-white" readonly />
                        <input type="hidden" asp-for="NgayHetHan" />
                        <small class="text-muted mt-1 d-block">Tự động +6 tháng từ ngày cấp</small>
                    </div>

                    <div class="mt-5 text-end">
                        <a asp-action="Index" class="btn btn-light me-2">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-save"></i> Lưu Thông Tin Thẻ
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>

    <script>
        $(document).ready(function () {
            // Kích hoạt bộ lịch cho ô nhập có class 'datepicker'
            flatpickr(".datepicker", {
                dateFormat: "d/m/Y", // Ép chuẩn định dạng Việt Nam
                locale: "vn",        // Hiển thị các thứ/tháng bằng tiếng Việt
                allowInput: true     // Cho phép người dùng gõ tay nếu không muốn bấm lịch
            });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}