@model CNPM_DeMo.Models.Book

@{
    ViewData["Title"] = "Cập Nhật Thông Tin Sách";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h4 class="fw-bold text-primary mb-1"><i class="bi bi-pencil-square"></i> Cập Nhật Thông Tin Sách</h4>
        <a asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="row g-4">
                <div class="col-md-4">
                    <label asp-for="MaSach" class="form-label fw-bold">Mã Sách <span class="text-danger">*</span></label>
                    <input asp-for="MaSach" class="form-control" required />
                    <span asp-validation-for="MaSach" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="TenSach" class="form-label fw-bold">Tên Sách <span class="text-danger">*</span></label>
                    <input asp-for="TenSach" class="form-control" required />
                    <span asp-validation-for="TenSach" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="TacGia" class="form-label fw-bold">Tác giả <span class="text-danger">*</span></label>
                    <input asp-for="TacGia" class="form-control" required />
                    <span asp-validation-for="TacGia" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TheLoai" class="form-label fw-bold">Thể loại <span class="text-danger">*</span></label>
                    <input asp-for="TheLoai" class="form-control" required />
                    <span asp-validation-for="TheLoai" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NhaXuatBan" class="form-label fw-bold">Nhà xuất bản <span class="text-danger">*</span></label>
                    <input asp-for="NhaXuatBan" class="form-control" required />
                    <span asp-validation-for="NhaXuatBan" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="NamXuatBan" class="form-label fw-bold">Năm XB</label>
                    <input asp-for="NamXuatBan" type="number" class="form-control" required />
                    <span asp-validation-for="NamXuatBan" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="GiaTri" class="form-label fw-bold">Giá trị (VNĐ)</label>
                    <input asp-for="GiaTri" type="number" step="1000" class="form-control" required />
                    <span asp-validation-for="GiaTri" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ViTri" class="form-label fw-bold">Vị trí (Kệ/Ngăn)</label>
                    <input asp-for="ViTri" class="form-control" />
                    <span asp-validation-for="ViTri" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="TrangThai" class="form-label fw-bold">Trạng thái hệ thống</label>
                    <select asp-for="TrangThai" class="form-select" asp-items="Html.GetEnumSelectList<CNPM_DeMo.Models.BookStatus>()">
                    </select>
                    <span asp-validation-for="TrangThai" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4 text-muted" />
            <div class="text-end">
                <button type="submit" class="btn btn-primary px-5 fw-bold" style="border-radius: 8px;">
                    <i class="bi bi-save"></i> Lưu Thay Đổi
                </button>
            </div>
        </form>
    </div>
</div>